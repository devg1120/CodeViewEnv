{
  "name": "codesight",
  "displayName": "CodeSight",
  "description": "AI-Powered Codebase Visualizer",
  "version": "0.0.1",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codesight.start",
        "title": "CodeSight: Start Visualizer"
      },
      {
        "command": "codesight.stop",
        "title": "CodeSight: Stop Server"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
